{
  "AppInfo": {
    "Name": "PortalHistoricoSIRH",
    "Detail": "Portal de consulta dos dados históricos do SIRH.",
    "Version": "CI_COMMIT_TAG"
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=DB_HOST; Database=DB_NAME; Username=DB_USER; Password=DB_PASS; SearchPath=historicorh"
  },
    "Authentication": {
        "Google": {
            "ClientSecret": "GOOGLE_CLIENTSECRET",
            "ClientId": "GOOGLE_CLIENTID"
        },
        "ApiGateway": {
            "Username": "API_GATEWAY_USERNAME",
            "Password": "API_GATEWAY_PASSWORD"
        }
    },
    "Monitoring": {
        "Matomo": {
            "APIUrl": "MATOMO_APIURL",
            "SiteId": "MATOMO_SITEID",
            "Stage": "MATOMO_STAGE",
            "Version": "MATOMO_VERSION"
        }
    },
    "Logging": {
        "LogLevel": {
            "Default": "LOG_LEVEL",
            "Microsoft": "LOG_LEVEL"
        }
    },
    "Sentry": {
        "Dsn": "SENTRY_DSN",
        "Release": "CI_COMMIT_TAG",
        "SendDefaultPii": true,
        "MaxRequestBodySize": "Always",
        "MinimumBreadcrumbLevel": "Debug",
        "MinimumEventLevel": "Error",
        "AttachStackTrace": true,
        "Debug": true,
        "DiagnosticLevel": "Error"
    },
    "AllowedHosts": "*",
    "BootstrapBlazorOptions": {
        "ToastDelay": 4000,
        "MessageDelay": 4000,
        "SwalDelay": 4000,
        "EnableErrorLogger": true,
        "FallbackCulture": "en",
        "SupportedCultures": [
            "pt-BR",
            "en-US",
            "es"
        ],
        "TableSettings": {
            "CheckboxColumnWidth": 36,
            "TableExportOptions": {
                "EnableFormat": true,
                "EnableLookup": true,
                "AutoMergeArray": true,
                "ArrayDelimiter": ","
            }
        },
        "IgnoreLocalizerMissing": true,
        "StepSettings": {
            "Short": "1",
            "Int": "1",
            "Long": "1",
            "Float": "0.1",
            "Double": "0.01",
            "Decimal": "0.01"
        },
        "DefaultCultureInfo": "pt-BR",
        "SupportedLanguages": [
            "pt-BR",
            "en-US",
            "es"
        ]
    },
    "JwtBearerTokenSettings": {
        "SecretKey": "JWTBEARERTOKEN_SECRETKEY",
        "Audience": "JWTBEARERTOKEN_AUDIENCE",
        "Issuer": "JWTBEARERTOKEN_ISSUER",
        "ExpiryTimeInSeconds": "JWTBEARERTOKEN_EXPIRETIME"
    },
    "BaseUrl": {
        "ApiUrl": "BASE_URL",
        "APIGatewayUrl": "API_GATEWAY_URL",
        "EmpregadoApiBasePath": "EMPREGADO_API_BASE_PATH",
        "UnidadeApiBasePath": "UNIDADE_API_BASE_PATH"
    }
}
